# Live e2e configuration. Copy to `.env` and fill in for `npm run test:e2e`.
# `.env` is gitignored — never commit real credentials.
# Use a DEDICATED TEST TENANT and a dedicated API-Key, never production.

# --- Required (Phase 1: task, identityprovider) ---
# Tenant base URI, no trailing slash.
DVELOP_E2E_SYSTEM_BASE_URI=https://your-tenant.d-velop.cloud
# Admin API-Key; exchanged for a live authSessionId at the start of each run.
DVELOP_E2E_API_KEY=

# --- Optional (Phase 2: dms) — suite self-skips if any of these are missing ---
DVELOP_E2E_DMS_REPOSITORY_ID=
DVELOP_E2E_DMS_SOURCE_ID=
DVELOP_E2E_DMS_CATEGORY_ID=
# Key of a writable string property on the category; used to stamp the run marker.
DVELOP_E2E_DMS_PROPERTY_KEY=

# --- Optional (Phase 2: business-objects) — suite self-skips if any are missing ---
# Model name and plural entity name as configured in the BusinessObjects-App.
DVELOP_E2E_BO_MODEL_NAME=sdktest
DVELOP_E2E_BO_PLURAL_ENTITY_NAME=SdkTests
